<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top">

  <section class="section page-top auth-section">
    <div class="container">
      <div class="auth-card" id="loginApp" data-config="<%= JSON.stringify(firebaseConfig) %>" data-next="<%= next %>">
        <span class="eyebrow">For Business Clients</span>
        <h1>Customer Login</h1>
        <p class="auth-sub">Track your pickup requests and book faster with your saved business details.</p>

        <% if (!loginEnabled) { %>
          <div class="form-alert info">
            Customer login is coming soon. You can still <a href="/book-pickup">request a bulk pickup</a> without an account.
          </div>
        <% } else { %>
          <div id="loginAlert" class="form-alert" hidden></div>

          <button type="button" class="btn btn-google btn-block" id="googleBtn">
            <svg class="google-logo" viewBox="0 0 48 48" aria-hidden="true">
              <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
              <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
              <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
              <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
            </svg>
            Continue with Google
          </button>

          <% if (phoneLoginEnabled) { %>
          <div class="auth-divider"><span>or log in with your mobile number</span></div>

          <form id="phoneForm" novalidate>
            <div class="form-group">
              <label for="loginPhone">Mobile Number</label>
              <div class="phone-input">
                <span class="phone-prefix">+91</span>
                <input type="tel" id="loginPhone" inputmode="numeric" maxlength="10" placeholder="98765 43210" autocomplete="tel-national">
              </div>
            </div>
            <button type="submit" class="btn btn-accent btn-lg btn-block" id="sendOtpBtn">Send OTP</button>
          </form>

          <form id="otpForm" novalidate hidden>
            <p class="otp-sent">We sent a 6-digit code to <strong id="otpPhoneLabel"></strong>.
              <button type="button" class="link-btn" id="changePhoneBtn">Change number</button></p>
            <div class="form-group">
              <label for="otpCode">Enter OTP</label>
              <input type="text" id="otpCode" inputmode="numeric" maxlength="6" placeholder="6-digit code" autocomplete="one-time-code">
            </div>
            <button type="submit" class="btn btn-accent btn-lg btn-block" id="verifyOtpBtn">Verify &amp; Log In</button>
          </form>

          <div id="recaptcha-container"></div>
          <% } %>
          <p class="auth-fine">No account needed to book — you can <a href="/book-pickup">request a pickup</a> anytime.</p>
        <% } %>
      </div>
    </div>
  </section>

</main>

<% if (loginEnabled) { %><script type="module" src="/js/login.js"></script><% } %>
<%- include('partials/footer') %>
