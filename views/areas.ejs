      <div class="section-head">
        <span class="eyebrow">Coverage</span>
        <h2>Areas We Serve Across Delhi NCR</h2>
        <p>Already active in these localities, expanding every month.</p>
      </div>
      <div class="areas-grid">
        <span class="area-badge">Dwarka</span>
        <span class="area-badge">Rohini</span>
        <span class="area-badge">Karol Bagh</span>
        <span class="area-badge">Lajpat Nagar</span>
        <span class="area-badge">Saket</span>
        <span class="area-badge">Vasant Kunj</span>
        <span class="area-badge">Pitampura</span>
        <span class="area-badge">Janakpuri</span>
        <span class="area-badge">Laxmi Nagar</span>
        <span class="area-badge">Mayur Vihar</span>
        <span class="area-badge">Preet Vihar</span>
        <span class="area-badge">Model Town</span>
        <span class="area-badge">Paschim Vihar</span>
        <span class="area-badge">Shahdara</span>
        <span class="area-badge">Chandni Chowk</span>
        <span class="area-badge">Greater Kailash</span>
        <span class="area-badge">Malviya Nagar</span>
        <span class="area-badge">Uttam Nagar</span>
        <span class="area-badge">Noida (select areas)</span>
        <span class="area-badge">Gurugram (select areas)</span>
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="cta-banner">
    <div class="container cta-inner">
      <h2>Got Scrap Lying Around at Home or Office?</h2>
      <p>Book a free pickup today and turn clutter into cash.</p>
      <div class="cta-actions">
        <a href="#book" class="btn btn-accent btn-lg">Book Pickup Now</a>
        <a href="tel:+919818826333" class="btn btn-outline-light btn-lg">
          <svg class="icon"><use href="#icon-phone"/></svg> Call Us
        </a>
      </div>
    </div>
    <svg class="section-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,40 C240,0 480,80 720,40 C960,0 1200,80 1440,40 L1440,80 L0,80 Z" fill="var(--color-dark)"/>
    </svg>
  </section>

</main>

</main>

