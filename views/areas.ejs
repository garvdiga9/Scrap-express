<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top">

<%- include('partials/page-hero', {
  eyebrow: 'Coverage',
  heading: 'Industrial & Commercial Areas We Serve',
  text: 'We collect bulk scrap from factories, offices and institutions across these hubs in Delhi NCR. Not listed? Call us — we cover the wider region too.',
}) %>

  <!-- Areas served -->
  <section class="section after-page-hero" id="areas">
    <div class="container">
      <div class="areas-grid">
        <% areas.forEach((area) => { %><span class="area-badge"><%= area %></span>
        <% }) %>
      </div>
    </div>
  </section>

<%- include('partials/cta') %>

</main>

<%- include('partials/footer') %>
