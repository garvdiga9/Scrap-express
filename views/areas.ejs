<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top">

  <!-- Areas served -->
  <section class="section page-top" id="areas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Coverage</span>
        <h2>Industrial &amp; Commercial Areas We Serve</h2>
        <p>We collect bulk scrap from factories, offices and institutions across these hubs in Delhi NCR. Not listed? Call us — we cover the wider region too.</p>
      </div>
      <div class="areas-grid">
        <% areas.forEach((area) => { %><span class="area-badge"><%= area %></span>
        <% }) %>
      </div>
    </div>
  </section>

<%- include('partials/cta') %>

</main>

<%- include('partials/footer') %>
