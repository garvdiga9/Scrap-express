<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>
<% const years = yearsInBusiness(); %>
<%
  const materials = [
    { icon: 'plastic', title: 'Plastic Scrap', text: 'PET bottles, HDPE, PP, films, crates, drums and mixed plastic from production and packaging.' },
    { icon: 'paper', title: 'Waste Paper & Cardboard', text: 'Cartons, kraft, office paper, newspaper and printing waste, loose or baled.' },
    { icon: 'metal', title: 'Iron & Steel Scrap', text: 'Heavy melting scrap, sheets, structures, machinery, racks and fabrication waste.' },
    { icon: 'copper-pipe', title: 'Copper, Brass & Aluminium', text: 'Wire, cable, pipes, radiators, castings and other non-ferrous metals.' },
    { icon: 'ewaste', title: 'Electronic & Electrical Waste', text: 'Computers, servers, UPS, batteries, ACs, motors and other end-of-life equipment.' },
    { icon: 'chair', title: 'Machinery & Office Clear-outs', text: 'Whole factories, offices, hotels and hospitals cleared, from furniture to generators.' },
  ];
  const team = [
    { icon: 'scale', title: 'Experienced Scrap Valuers', text: 'They inspect your lot, identify every grade and price it fairly, on site or from your photos.' },
    { icon: 'clock', title: 'Market Intelligence', text: 'They follow metal, paper and plastic prices every day, so our quotes keep up with the market.' },
    { icon: 'truck', title: 'Pickup & Logistics Crews', text: 'Trained crews with trucks and weighing equipment for safe, quick collection from your site.' },
    { icon: 'paper', title: 'Finance & Accounts', text: 'GST invoices, weight slips and prompt payments, ready for your company\'s books.' },
    { icon: 'shield', title: 'Legal, Risk & Compliance', text: 'Proper paperwork, safe handling and responsible recycling, so your disposal is on record.' },
    { icon: 'building', title: 'Corporate Partnerships', text: 'Empanelled channel partners and a dedicated desk for large companies and regular contracts.' },
  ];
  const ways = [
    { icon: 'user', title: 'Experienced professionals', text: `In the scrap trade since ${foundedYear}, with valuers who know every grade.` },
    { icon: 'scale', title: 'Honest weighing', text: 'Every load is weighed on a weighbridge or calibrated scale, with a photo of the reading and a receipt.' },
    { icon: 'quote', title: 'Competitive prices', text: 'Rates that follow the market every day. You see the rate for each material and agree to it first.' },
    { icon: 'check', title: 'Strict quality standards', text: 'Scrap is sorted by material and grade, so recyclers and mills get consistent lots.' },
    { icon: 'clock', title: 'Timely pickup and delivery', text: 'You choose the pickup time and follow our team live. Lots for buyers leave on schedule.' },
    { icon: 'shield', title: 'Paid on time', text: 'Cash on the spot, a bank transfer or an online payment, whichever you prefer, with a proper GST invoice.' },
    { icon: 'map', title: 'Wide network', text: 'A wide network of recyclers, mills and buyers, so every material finds the best home and price.' },
    { icon: 'gear', title: 'Streamlined operations', text: 'Online quotes, pickup slots, live tracking and digital receipts: modern tools behind a proven record.' },
  ];
%>

<main id="top" tabindex="-1">

<%- include('partials/page-hero', {
  eyebrow: 'About Us',
  heading: `Delhi's trusted scrap partner since ${foundedYear}`,
  text: `For ${years} years we have bought, sorted and recycled scrap for Delhi's businesses, from a single office clear-out to regular contracts with large companies.`,
  links: [{ href: '#story', label: 'Our story' }, { href: '#team', label: 'Our team' }, { href: '#why-us', label: 'Why us' }, { href: '#visit', label: 'Visit us' }],
}) %>

  <section class="section after-page-hero" id="story">
    <div class="container about-story">
      <div class="about-story-text">
        <span class="eyebrow">Our Story</span>
        <h2>From a Delhi scrap trader to a partner for businesses</h2>
        <p>We started in Delhi in <%= foundedYear %> as wholesale and retail scrap traders. Over the years we have grown into one of the fastest growing and most trusted scrap partners for factories, offices, hospitals, institutions and well-established corporate companies, many of which have worked with us for years.</p>
        <p>We handle large consignments of plastic scrap, waste paper, iron and steel, non-ferrous metals and electronic scrap. Because we deal in volume, we can offer fair rates, weigh every load properly and pay promptly, with the paperwork your accounts team needs.</p>
        <p>Today we combine that experience with modern tools: online quotes, pickup slots you choose, live updates as our team arrives, and a digital receipt for every pickup. Selling scrap should be as simple for a business as ordering anything else.</p>
      </div>
      <div class="about-facts">
        <div class="about-fact"><strong><%= foundedYear %></strong><span>Started in Delhi</span></div>
        <div class="about-fact"><strong><%= years %>+</strong><span>Years in the scrap trade</span></div>
        <div class="about-fact"><strong><%= teamSize.min %>–<%= teamSize.max %> people</strong><span>Our team: buyers, pickup crews and office staff</span></div>
        <div class="about-fact"><strong>Wholesale &amp; Retail</strong><span>From single lots to regular contracts</span></div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="team">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Team</span>
        <h2><%= teamSize.min %>–<%= teamSize.max %> people, each with a clear job</h2>
        <p>Behind every pickup is a team that values, collects, pays and keeps the records straight.</p>
      </div>
      <div class="why-grid">
        <% team.forEach((t) => { %>
          <div class="why-card">
            <svg class="icon icon-lg"><use href="#icon-<%= t.icon %>"/></svg>
            <h3><%= t.title %></h3>
            <p><%= t.text %></p>
          </div>
        <% }) %>
      </div>
      <div class="about-contact-line">
        <span>For more information</span>
        <button type="button" class="btn btn-accent" data-callback>Contact Us</button>
        <a href="tel:+919818826333" class="btn btn-outline">Call +91 98188 26333</a>
      </div>
    </div>
  </section>

  <section class="section" id="materials">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What We Handle</span>
        <h2>Large consignments of every kind of scrap</h2>
        <p>If your business has scrap, we can most likely take it. <a href="/what-we-buy">See everything we buy</a>.</p>
      </div>
      <div class="why-grid">
        <% materials.forEach((m) => { %>
          <div class="why-card">
            <svg class="icon icon-lg"><use href="#icon-<%= m.icon %>"/></svg>
            <h3><%= m.title %></h3>
            <p><%= m.text %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="why-us">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why Us</span>
        <h2>Why businesses choose us</h2>
        <p>With an experienced team and the right tools, we deliver to industry standards on every lot. Our corporate clients trust us because every step is open and on record.</p>
      </div>
      <div class="why-grid about-why-grid">
        <% ways.forEach((w) => { %>
          <div class="why-card">
            <svg class="icon icon-lg"><use href="#icon-<%= w.icon %>"/></svg>
            <h3><%= w.title %></h3>
            <p><%= w.text %></p>
          </div>
        <% }) %>
      </div>
      <%- include('partials/trade-terms') %>
    </div>
  </section>

  <section class="section" id="responsibility">
    <div class="container about-story">
      <div class="about-story-text">
        <span class="eyebrow">Our Responsibility</span>
        <h2>Good for business, good for the environment</h2>
        <p>We are a socially responsible company and we care about the environment we all share. Scrap that would otherwise end up in a landfill is sorted by material and sent back into manufacturing as raw material.</p>
        <p>We buy old and end-of-life electrical and electronic equipment (e-waste) and see that it is recycled, so its metals, plastics and other materials are used to make new, useful products instead of polluting soil and water.</p>
      </div>
      <div class="about-facts">
        <div class="about-fact"><svg class="icon icon-lg"><use href="#icon-recycle"/></svg><span>Sorted by material, sent back into manufacturing</span></div>
        <div class="about-fact"><svg class="icon icon-lg"><use href="#icon-leaf"/></svg><span>Less waste in landfills</span></div>
        <div class="about-fact"><svg class="icon icon-lg"><use href="#icon-ewaste"/></svg><span>E-waste recycled responsibly</span></div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="visit">
    <div class="container">
      <div class="about-visit">
        <div>
          <span class="eyebrow">Visit Us</span>
          <h2>Our shop in Rohini</h2>
          <p class="about-address"><svg class="icon"><use href="#icon-map"/></svg> <span><%= shopAddress.full %></span></p>
          <p><svg class="icon"><use href="#icon-phone"/></svg> <a href="tel:+919818826333">+91 98188 26333</a></p>
          <p><svg class="icon"><use href="#icon-clock"/></svg> <span>Monday: 9 AM – 2 PM<br>Tuesday – Sunday: 9 AM – 8 PM</span></p>
        </div>
        <div class="about-visit-actions">
          <a href="/book-pickup" class="btn btn-accent btn-lg">Get a Quote</a>
          <a href="<%= shopAddress.mapsUrl %>" target="_blank" rel="noopener" class="btn btn-outline btn-lg">Open in Google Maps</a>
        </div>
      </div>
    </div>
  </section>

<%- include('partials/cta') %>

</main>

<%- include('partials/footer') %>
