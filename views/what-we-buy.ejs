<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top">

  <!-- Everything We Buy -->
  <section class="section page-top" id="buy">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Beyond Scrap Metal</span>
        <h2>Everything We Buy</h2>
        <p>From office IT equipment and factory machinery to full commercial demolitions — if your business has scrap, we'll take it. Pricing depends on brand, tonnage, volume &amp; condition, so we quote after assessing the lot.</p>
      </div>
      <div class="buy-grid">
        <div class="buy-card">
          <div class="buy-icon"><svg class="icon icon-lg"><use href="#icon-snowflake"/></svg></div>
          <h3>AC, Fridge &amp; Cold Storage</h3>
          <div class="buy-items">
            <span>Normal AC (by ton &amp; brand)</span>
            <span>Inverter AC</span>
            <span>Fridge (50L - 800L)</span>
            <span>AC Cooling Condenser</span>
            <span>AC Compressor</span>
            <span>AC Motor</span>
            <span>AC PCB</span>
            <span>Air Cooled AC Plant</span>
            <span>Water Cooled AC Plant</span>
            <span>Cold Storage</span>
          </div>
          <a href="/book-pickup" class="buy-link">Get a Quote</a>
        </div>

        <div class="buy-card">
          <div class="buy-icon"><svg class="icon icon-lg"><use href="#icon-bolt"/></svg></div>
          <h3>Generators &amp; Motors</h3>
          <div class="buy-items">
            <span>Generators (0.5 kW - 500 kW)</span>
            <span>Shri Ram Honda</span>
            <span>Kirloskar</span>
            <span>Sudhir</span>
            <span>Mahindra</span>
            <span>Motors (0.5 HP - 500 HP)</span>
            <span>Copper Winding Motor</span>
            <span>Aluminium Winding Motor</span>
          </div>
          <a href="/book-pickup" class="buy-link">Get a Quote</a>
        </div>

        <div class="buy-card">
          <div class="buy-icon"><svg class="icon icon-lg"><use href="#icon-droplet"/></svg></div>
          <h3>Water Heaters</h3>
          <div class="buy-items">
            <span>Electric Geyser (2L - 50L)</span>
            <span>Gas Geyser</span>
          </div>
          <a href="/book-pickup" class="buy-link">Get a Quote</a>
        </div>

        <div class="buy-card">
          <div class="buy-icon"><svg class="icon icon-lg"><use href="#icon-monitor"/></svg></div>
          <h3>Computers &amp; IT Equipment</h3>
          <div class="buy-items">
            <span>Complete PC</span>
            <span>CPU</span>
            <span>Hard Disk</span>
            <span>Laptop</span>
            <span>Motherboard</span>
            <span>UPS</span>
            <span>Monitor</span>
            <span>Keyboard, Mouse &amp; Speakers</span>
          </div>
          <a href="/book-pickup" class="buy-link">Get a Quote</a>
        </div>

        <div class="buy-card">
          <div class="buy-icon"><svg class="icon icon-lg"><use href="#icon-chair"/></svg></div>
          <h3>Furniture &amp; Fixtures</h3>
          <div class="buy-items">
            <span>Office Workstations</span>
            <span>Office Chairs &amp; Tables</span>
            <span>Almirahs &amp; Storage Racks</span>
            <span>Sofas &amp; Lounge Seating</span>
            <span>Hotel &amp; Hospital Beds</span>
            <span>Fans &amp; Washing Machines</span>
            <span>Kitchen Equipment</span>
            <span>Gym Machines</span>
          </div>
          <a href="/book-pickup" class="buy-link">Get a Quote</a>
        </div>

        <div class="buy-card">
          <div class="buy-icon"><svg class="icon icon-lg"><use href="#icon-bottle"/></svg></div>
          <h3>Glass Items</h3>
          <div class="buy-items">
            <span>Whiskey &amp; Glass Bottles</span>
            <span>Showroom Glass</span>
            <span>Office &amp; Building Glass</span>
            <span>Factory Glass</span>
          </div>
          <a href="/book-pickup" class="buy-link">Get a Quote</a>
        </div>

        <div class="buy-card">
          <div class="buy-icon"><svg class="icon icon-lg"><use href="#icon-crane"/></svg></div>
          <h3>Demolition Projects</h3>
          <div class="buy-items">
            <span>Banquet Halls</span>
            <span>Farm Houses</span>
            <span>Factories</span>
            <span>Houses</span>
            <span>Malls</span>
            <span>Schools</span>
            <span>Hospitals</span>
          </div>
          <a href="/demolition" class="buy-link">Request Site Visit</a>
        </div>
      </div>
    </div>
  </section>

<%- include('partials/cta') %>

</main>

<%- include('partials/footer') %>
