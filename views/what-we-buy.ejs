            <span>Sofa</span>
            <span>Single &amp; Double Bed</span>
            <span>Almirah</span>
            <span>Tables &amp; Chairs</span>
            <span>Old Fan</span>
            <span>Washing Machine</span>
            <span>Mixer</span>
            <span>Gym Machines</span>
