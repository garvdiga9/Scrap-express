<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>
<% const c = customer; %>
<% const fmtDate = (d) => new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' }); %>

<main id="top" tabindex="-1">

  <section class="section page-top">
    <div class="container">
      <div class="account-head">
        <div id="accountIntro" data-live-block>
          <span class="eyebrow">My Account</span>
          <h1>Welcome<%= c.name ? `, ${c.name}` : '' %></h1>
          <p class="account-sub">Logged in with <%= c.verified_phone || c.email || 'your account' %><%= c.company_name ? ` · ${c.company_name}` : '' %></p>
        </div>
        <div class="account-actions">
          <a href="/book-pickup" class="btn btn-accent">Request a Bulk Pickup</a>
          <button type="button" class="btn btn-outline" id="logoutBtn">Log Out</button>
        </div>
      </div>

      <div class="push-card" id="pushCard" hidden>
        <svg class="icon push-icon"><use href="#icon-bell"/></svg>
        <div class="push-copy">
          <strong>Turn on alerts for your pickups</strong>
          <span data-push-status></span>
        </div>
        <button type="button" class="btn btn-accent" data-push-toggle hidden>Turn On Notifications</button>
      </div>

      <div id="accountTodo" data-live-block><%- include('partials/customer-todo', { requests }) %></div>

      <div class="account-grid">
        <section class="account-card" id="accountRequests" data-live-block>
          <h2>Your Requests</h2>
          <% if (!requests.length) { %>
            <div class="account-empty">
              <p>No requests yet. When you book a pickup or demolition while logged in, it shows up here with its live status.</p>
              <a href="/book-pickup" class="btn btn-outline">Request a Bulk Pickup</a>
            </div>
          <% } else { %>
            <ul class="request-list">
              <% requests.forEach((r) => { %>
                <li class="request-item" id="request-<%= r.kind %>-<%= r.id %>">
                  <div class="request-main">
                    <span class="request-kind"><%= r.kind === 'pickup' ? (r.delivery_mode === 'self' ? 'Drop-off' : 'Bulk Pickup') : 'Demolition' %> · #<%= r.id %> · <%= fmtDate(r.created_at) %></span>
                    <strong class="request-detail"><%= r.detail %></strong>
                    <span class="request-meta"><%= [r.quantity && (r.item_quantities ? `${r.quantity} in total` : r.quantity), r.frequency, r.location].filter(Boolean).join(' · ') %></span>
                    <% if (r.item_quantities && r.item_quantities.length) { %>
                      <span class="request-items"><%= r.item_quantities.map((i) => `${i.type}: ${i.quantity} ${i.unit}`).join(' · ') %></span>
                    <% } %>
                  </div>
                  <span class="status-badge status-<%= r.status %>"><%= statusLabels[r.status] || r.status %></span>
                  <%- include('partials/request-progress', { timeline: r.timeline, docs: r.docs, docBase: '/api/customer/documents/', pickup: r.pickup, receiptUrl: r.quote_token ? `/quote/${r.quote_token}/receipt` : null }) %>
                  <% if (r.quote_items && r.quote_items.length) { %>
                    <%- include('partials/quote-box', { r, api: `/api/customer/requests/${r.id}` }) %>
                  <% } %>
                  <% if (r.kind === 'pickup' && ['completed', 'confirmed', 'ready', 'accepted', 'scheduled'].includes(r.status)) { %>
                    <details class="repeat-pickup">
                      <summary>Repeat this pickup</summary>
                      <form class="repeat-form" method="post" data-source="<%= r.id %>" novalidate>
                        <p class="repeat-help">We'll create a new request from this one (same site, scrap and contact) two days before each date, and call you to confirm the quantity.</p>
                        <div class="repeat-row">
                          <label>How often
                            <select name="frequency">
                              <% Object.entries(repeatFrequencies).forEach(([key, f]) => { %><option value="<%= key %>"<%= key === 'monthly' ? ' selected' : '' %>><%= f.label %></option><% }) %>
                            </select>
                          </label>
                          <label>First pickup on
                            <input type="date" name="startDate" required min="<%= repeatDates.min %>" max="<%= repeatDates.max %>" value="<%= repeatDates.min %>">
                          </label>
                        </div>
                        <label class="rules-check-label"><input type="checkbox" name="acceptTerms"> <span>The <a href="/rules" target="_blank" rel="noopener">Pickup Rules</a> apply to every repeat pickup.</span></label>
                        <div class="form-alert error" hidden></div>
                        <button type="submit" class="btn btn-accent">Set Up Repeat Pickup</button>
                      </form>
                    </details>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </section>

        <% if (repeatPickups.length) { %>
        <section class="account-card" id="accountRepeats" data-live-block>
          <h2>Repeat Pickups</h2>
          <ul class="repeat-list">
            <% repeatPickups.forEach((s) => { %>
              <li class="repeat-item<%= s.active ? '' : ' repeat-paused' %>" data-schedule="<%= s.id %>">
                <div>
                  <strong><%= s.frequencyLabel %><%= s.active ? '' : (s.frequency === 'once' ? ' (done)' : ' (paused)') %></strong>
                  <span class="request-meta"><%= [s.scrap_type, s.approx_quantity, s.area].filter(Boolean).join(' · ') %></span>
                  <% if (s.active) { %><span class="request-meta">Next pickup: <%= new Date(s.next_date + 'T00:00:00').toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %></span><% } %>
                </div>
                <div class="repeat-actions">
                  <% if (s.frequency !== 'once') { %>
                    <button type="button" class="btn btn-outline btn-sm" data-schedule-toggle="<%= s.active ? 'pause' : 'resume' %>"><%= s.active ? 'Pause' : 'Resume' %></button>
                  <% } %>
                  <button type="button" class="btn btn-outline btn-sm" data-schedule-delete>Delete</button>
                </div>
              </li>
            <% }) %>
          </ul>
        </section>
        <% } %>

        <section class="account-card">
          <h2>Business Details</h2>
          <p class="account-note">Saved details fill in your booking form automatically.</p>
          <div id="profileAlert" class="form-alert" hidden></div>
          <form id="profileForm" method="post" novalidate>
            <div class="form-group">
              <label for="pCompany">Company / Organisation</label>
              <input type="text" id="pCompany" name="companyName" maxlength="200" value="<%= c.company_name || '' %>">
            </div>
            <div class="form-group">
              <label for="pBusinessType">Business Type</label>
              <select id="pBusinessType" name="businessType">
                <option value="">Select type</option>
                <% businessTypes.forEach((type) => { %><option<%= c.business_type === type ? ' selected' : '' %>><%= type %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="pName">Contact Person</label>
                <input type="text" id="pName" name="name" maxlength="150" value="<%= c.name || '' %>">
              </div>
              <div class="form-group">
                <label for="pPhone">Contact Phone</label>
                <input type="tel" id="pPhone" name="phone" maxlength="20" value="<%= c.phone || '' %>">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="pEmail">Work Email</label>
                <input type="email" id="pEmail" name="email" maxlength="200" value="<%= c.email || '' %>">
              </div>
              <div class="form-group">
                <label for="pGstin">GSTIN</label>
                <input type="text" id="pGstin" name="gstin" maxlength="15" placeholder="07ABCDE1234F1Z5" value="<%= c.gstin || '' %>">
              </div>
            </div>
            <%- include('partials/location-fields', { prefix: 'p', c }) %>
            <%- include('partials/area-field', { prefix: 'p', c, required: false }) %>
            <button type="submit" class="btn btn-accent btn-block" id="saveProfileBtn">Save Details</button>
          </form>
        </section>
      </div>

      <section class="account-card danger-card">
        <div>
          <h2>Delete Account</h2>
          <p>Permanently deletes your account, saved details, and the photos and videos you sent us. Records of past requests are kept for tax purposes. <a href="/delete-account">Details</a></p>
          <div id="deleteAlert" class="form-alert error" hidden></div>
        </div>
        <button type="button" class="btn btn-danger" id="deleteAccountBtn"
                data-config="<%= JSON.stringify(firebaseConfig) %>">Delete My Account</button>
      </section>
    </div>
  </section>

</main>

<script src="/js/account.js"></script>
<script type="module" src="/js/account-delete.js"></script>
<%- include('partials/footer') %>
