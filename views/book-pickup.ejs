<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top">

  <!-- Book a pickup -->
  <section class="section page-top" id="book">
    <div class="container book-inner">
      <div class="section-head book-head">
        <span class="eyebrow">For Businesses</span>
        <h2>Request a Bulk Pickup</h2>
        <p>Tell us what scrap you have and where your site is. Our team will call you to confirm the details and share a quote.</p>
        <ul class="book-points">
          <li><svg class="icon"><use href="#icon-check"/></svg> GST invoice &amp; weighbridge weight slip</li>
          <li><svg class="icon"><use href="#icon-check"/></svg> Payment by bank transfer to your company account</li>
          <li><svg class="icon"><use href="#icon-check"/></svg> One-time clearances or scheduled pickups</li>
          <li><svg class="icon"><use href="#icon-check"/></svg> Minimum <%= minPickupKg %> kg per pickup</li>
          <li><svg class="icon"><use href="#icon-check"/></svg> Pickup charges may vary depending on location &amp; quantity</li>
        </ul>
      </div>
      <%# Logged-in customers get their saved details pre-filled. These are the
          fields' default values, so the form keeps them after a successful
          submit's reset, ready for the next booking. %>
      <% const c = locals.customer || {}; %>
      <form class="book-form" id="pickupForm" novalidate>
        <% if (locals.customer) { %>
          <div class="form-alert info">Logged in<%= c.company_name ? ` as ${c.company_name}` : '' %> — your saved details are filled in. This request will appear in <a href="/account">My Account</a>.</div>
        <% } else if (locals.loginEnabled) { %>
          <div class="form-alert info">Have an account? <a href="/login?next=/book-pickup">Log in</a> to fill this in automatically and track your request.</div>
        <% } %>
        <div id="formAlert" class="form-alert" hidden></div>
        <div class="form-row">
          <div class="form-group">
            <label for="companyName">Company / Organisation *</label>
            <input type="text" id="companyName" name="companyName" required placeholder="Company name" value="<%= c.company_name || '' %>">
          </div>
          <div class="form-group">
            <label for="businessType">Business Type *</label>
            <select id="businessType" name="businessType" required>
              <option value="" disabled<%= c.business_type ? '' : ' selected' %>>Select type</option>
              <% businessTypes.forEach((type) => { %><option<%= c.business_type === type ? ' selected' : '' %>><%= type %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Contact Person *</label>
            <input type="text" id="name" name="name" required placeholder="Full name" value="<%= c.name || '' %>">
          </div>
          <div class="form-group">
            <label for="phone">Phone Number *</label>
            <input type="tel" id="phone" name="phone" required placeholder="98765 43210" value="<%= c.phone || '' %>">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="email">Work Email (optional)</label>
            <input type="email" id="email" name="email" placeholder="you@company.com" value="<%= c.email || '' %>">
          </div>
          <div class="form-group">
            <label for="gstin">GSTIN (optional)</label>
            <input type="text" id="gstin" name="gstin" maxlength="15" placeholder="07ABCDE1234F1Z5" value="<%= c.gstin || '' %>">
          </div>
        </div>
        <div class="form-group">
          <label for="address">Site Address *</label>
          <textarea id="address" name="address" required rows="2" placeholder="Plot / building no., industrial area, landmark"><%= c.address || '' %></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="area">Area *</label>
            <select id="area" name="area" required>
              <option value="" disabled<%= c.area ? '' : ' selected' %>>Select your area</option>
              <% [...areas, 'Other Delhi NCR'].forEach((area) => { %><option<%= c.area === area ? ' selected' : '' %>><%= area %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="pincode">Pincode</label>
            <input type="text" id="pincode" name="pincode" placeholder="110001" maxlength="6" value="<%= c.pincode || '' %>">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="preferredDate">Preferred Date</label>
            <input type="date" id="preferredDate" name="preferredDate">
          </div>
          <div></div>
        </div>
        <fieldset class="form-group checkbox-group" id="scrapTypesGroup">
          <legend>Scrap Types * <span class="field-hint">Select all that apply</span></legend>
          <div class="checkbox-grid">
            <% scrapTypes.forEach((type) => { %><label class="check-chip">
              <input type="checkbox" name="scrapTypes" value="<%= type %>">
              <span><%= type %></span>
            </label>
            <% }) %>
            <label class="check-chip">
              <input type="checkbox" name="scrapTypes" value="Other" id="scrapTypeOther" aria-controls="otherScrapWrap">
              <span>Other</span>
            </label>
          </div>
          <div class="other-scrap" id="otherScrapWrap" hidden>
            <label for="otherScrapType">Describe the other scrap *</label>
            <input type="text" id="otherScrapType" name="otherScrapType" maxlength="100" placeholder="e.g. wooden pallets, rubber, lead batteries">
          </div>
        </fieldset>
        <div class="form-row">
          <div class="form-group">
            <label for="quantity">Approx. Total Quantity * <span class="field-hint">Min. <%= minPickupKg %> kg</span></label>
            <div class="quantity-input">
              <input type="number" id="quantity" name="quantity" required min="0" step="any" inputmode="decimal" placeholder="e.g. 500" data-min-kg="<%= minPickupKg %>">
              <select id="quantityUnit" name="quantityUnit" aria-label="Quantity unit">
                <option value="kg" selected>kg</option>
                <option value="tonnes">tonnes</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="pickupFrequency">Pickup Frequency *</label>
            <select id="pickupFrequency" name="pickupFrequency" required>
              <% pickupFrequencies.forEach((freq, i) => { %><option<%= i === 0 ? ' selected' : '' %>><%= freq %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="notes">Additional Notes</label>
          <textarea id="notes" name="notes" rows="2" placeholder="Quantity per scrap type, access timings, loading help needed, etc."></textarea>
        </div>
        <button type="submit" class="btn btn-accent btn-lg btn-block" id="submitBtn">Request Bulk Quote</button>
      </form>
    </div>
  </section>

<%- include('partials/cta') %>

</main>

<%- include('partials/footer') %>
