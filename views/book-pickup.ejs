<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top">

  <!-- Book a pickup -->
  <section class="section page-top" id="book">
    <div class="container book-inner">
      <div class="section-head book-head">
        <span class="eyebrow">For Businesses</span>
        <h2>Request a Bulk Pickup</h2>
        <p>Tell us what scrap you have and where your site is. Our team will call you to confirm the details and share a quote.</p>
        <ul class="book-points">
          <li><svg class="icon"><use href="#icon-check"/></svg> GST invoice &amp; weighbridge weight slip</li>
          <li><svg class="icon"><use href="#icon-check"/></svg> Payment by bank transfer to your company account</li>
          <li><svg class="icon"><use href="#icon-check"/></svg> One-time clearances or scheduled pickups</li>
          <li><svg class="icon"><use href="#icon-check"/></svg> Pickup charges may vary depending on location &amp; quantity</li>
        </ul>
      </div>
      <form class="book-form" id="pickupForm" novalidate>
        <div id="formAlert" class="form-alert" hidden></div>
        <div class="form-row">
          <div class="form-group">
            <label for="companyName">Company / Organisation *</label>
            <input type="text" id="companyName" name="companyName" required placeholder="Company name">
          </div>
          <div class="form-group">
            <label for="businessType">Business Type *</label>
            <select id="businessType" name="businessType" required>
              <option value="" disabled selected>Select type</option>
              <% businessTypes.forEach((type) => { %><option><%= type %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Contact Person *</label>
            <input type="text" id="name" name="name" required placeholder="Full name">
          </div>
          <div class="form-group">
            <label for="phone">Phone Number *</label>
            <input type="tel" id="phone" name="phone" required placeholder="98765 43210">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="email">Work Email (optional)</label>
            <input type="email" id="email" name="email" placeholder="you@company.com">
          </div>
          <div class="form-group">
            <label for="area">Area *</label>
            <select id="area" name="area" required>
              <option value="" disabled selected>Select your area</option>
              <% areas.forEach((area) => { %><option><%= area %></option>
              <% }) %>
              <option>Other Delhi NCR</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="address">Site Address *</label>
          <textarea id="address" name="address" required rows="2" placeholder="Plot / building no., industrial area, landmark"></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="pincode">Pincode</label>
            <input type="text" id="pincode" name="pincode" placeholder="110001" maxlength="6">
          </div>
          <div class="form-group">
            <label for="preferredDate">Preferred Date</label>
            <input type="date" id="preferredDate" name="preferredDate">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="scrapType">Scrap Type *</label>
            <select id="scrapType" name="scrapType" required>
              <option value="" disabled selected>Select main category</option>
              <option>Paper &amp; Cardboard</option>
              <option>Plastic</option>
              <option>Iron &amp; Steel</option>
              <option>Copper / Brass / Aluminium</option>
              <option>E-Waste &amp; IT Equipment</option>
              <option>AC, Fridge &amp; Cooling Equipment</option>
              <option>Generators &amp; Motors</option>
              <option>Furniture &amp; Fixtures</option>
              <option>Mixed Industrial / Office Scrap</option>
            </select>
          </div>
          <div class="form-group">
            <label for="quantity">Approx. Quantity</label>
            <input type="text" id="quantity" name="quantity" placeholder="e.g. 500 kg or 2 tons">
          </div>
        </div>
        <div class="form-group">
          <label for="pickupFrequency">Pickup Frequency *</label>
          <select id="pickupFrequency" name="pickupFrequency" required>
            <% pickupFrequencies.forEach((freq, i) => { %><option<%= i === 0 ? ' selected' : '' %>><%= freq %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="notes">Additional Notes</label>
          <textarea id="notes" name="notes" rows="2" placeholder="Access timings, loading help needed, GST details, etc."></textarea>
        </div>
        <button type="submit" class="btn btn-accent btn-lg btn-block" id="submitBtn">Request Bulk Quote</button>
      </form>
    </div>
  </section>

<%- include('partials/cta') %>

</main>

<%- include('partials/footer') %>
