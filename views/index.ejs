<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-blob blob-1"></div>
    <div class="hero-blob blob-2"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow eyebrow-live"><span class="live-dot" aria-hidden="true"></span> B2B Scrap Buyers • Delhi NCR</span>
        <h1>Scrap Ka Dher? <span class="text-accent">Hum Hai Na!</span><span class="sr-only"> Bulk scrap buyers for businesses across Delhi NCR.</span></h1>
        <p class="hero-rotator">
          <span aria-hidden="true">Bulk scrap pickup from your</span>
          <span class="rotator-word" id="heroRotator" aria-hidden="true"
                data-words='["factory","office","hospital","restaurant","warehouse","school","mall","hotel"]'>factory</span><span class="rotator-caret" aria-hidden="true"></span>
          <span class="sr-only">Bulk scrap pickup from factories, offices, hospitals, restaurants, warehouses, schools, malls and hotels.</span>
        </p>
        <p class="hero-sub">One-time clearances or scheduled pickups of <%= minPickupKg %> kg and above — weighed on a weighbridge, billed with a GST invoice and paid by bank transfer.</p>
        <div class="hero-cta">
          <a href="/book-pickup" class="btn btn-accent btn-lg btn-glow">Request a Bulk Quote <span class="btn-arrow" aria-hidden="true">→</span></a>
          <a href="/rates" class="btn btn-outline-light btn-lg">View Indicative Rates</a>
        </div>
        <ul class="hero-badges">
          <li><svg class="icon"><use href="#icon-paper"/></svg> GST Invoice</li>
          <li><svg class="icon"><use href="#icon-scale"/></svg> Weighbridge Slip</li>
          <li><svg class="icon"><use href="#icon-shield"/></svg> Bank Transfer</li>
        </ul>
        <div class="hero-stats" id="heroStats">
          <div class="stat"><span class="stat-num-row"><span class="stat-num" data-count="35">0</span><span class="stat-num-suffix">+</span></span><span class="stat-label">Years in Delhi</span></div>
          <div class="stat"><span class="stat-num-row"><span class="stat-num" data-count="100">0</span><span class="stat-num-suffix">+</span></span><span class="stat-label">Locations Served</span></div>
          <div class="stat"><span class="stat-num-row"><span class="stat-num" data-count="500">0</span><span class="stat-num-suffix">+</span></span><span class="stat-label">Tons Recycled / Month</span></div>
          <div class="stat"><span class="stat-num-row"><span class="stat-num" data-count="10000">0</span><span class="stat-num-suffix">+</span></span><span class="stat-label">Clients Served</span></div>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <svg class="hero-illustration" viewBox="0 0 400 400">
          <circle class="hero-orbit" cx="200" cy="200" r="150" stroke="rgba(255,255,255,0.12)" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" fill="none"/>
          <circle class="hero-orbit hero-orbit-inner" cx="200" cy="200" r="95" stroke="rgba(245,158,11,0.18)" stroke-width="2" stroke-dasharray="1 14" stroke-linecap="round" fill="none"/>
          <use href="#icon-building" x="176" y="22" width="48" height="48" style="color:rgba(255,255,255,0.6)"/>
          <use href="#icon-truck" x="34" y="296" width="48" height="48" style="color:rgba(255,255,255,0.55)"/>
          <use href="#icon-recycle" x="308" y="296" width="48" height="48" style="color:var(--color-accent)"/>
          <circle cx="200" cy="50" r="4" fill="rgba(255,255,255,0.5)"/>
          <circle cx="70" cy="320" r="4" fill="rgba(255,255,255,0.5)"/>
          <circle cx="330" cy="320" r="4" fill="var(--color-accent)"/>
        </svg>
        <div class="hero-card card-truck">
          <svg class="icon icon-xl"><use href="#icon-truck"/></svg>
          <p>On-site pickup across Delhi NCR</p>
        </div>
        <div class="hero-card card-scale">
          <svg class="icon icon-xl"><use href="#icon-scale"/></svg>
          <p>Weighbridge weight slip</p>
        </div>
        <div class="hero-card card-cash">
          <span class="cash-symbol">₹</span>
          <p>GST invoice &amp; bank transfer</p>
        </div>
      </div>
    </div>
    <svg class="section-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z" fill="var(--color-white)"/>
    </svg>
  </section>

  <!-- Who we serve: a slow, endless strip. The list is drawn twice so the
       loop has no visible seam; the copy is hidden from screen readers. -->
  <% const serve = [
    ['icon-gear', 'Factories'], ['icon-building', 'Offices & IT Parks'], ['icon-shield', 'Hospitals'],
    ['icon-book', 'Schools & Colleges'], ['icon-box', 'Malls & Retail'], ['icon-home', 'Hotels & Banquets'],
    ['icon-droplet', 'Restaurants & Food Chains'], ['icon-truck', 'Warehouses'], ['icon-hardhat', 'Construction Sites'],
  ]; %>
  <section class="serve-strip" aria-label="Businesses we serve">
    <div class="serve-track">
      <% [false, true].forEach((copy) => { %>
        <ul class="serve-list"<%- copy ? ' aria-hidden="true"' : '' %>>
          <% serve.forEach(([icon, label]) => { %><li><svg class="icon"><use href="#<%= icon %>"/></svg><%= label %></li><% }) %>
        </ul>
      <% }) %>
    </div>
  </section>

  <!-- Environmental Impact -->
  <section class="section section-alt" id="impact">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Impact</span>
        <h2>Every Kilogram Counts</h2>
        <p>Estimated environmental impact from scrap responsibly recycled through Scrap Express.</p>
      </div>
      <div class="impact-grid" id="impactStats">
        <div class="impact-card">
          <div class="impact-icon"><svg class="icon icon-lg"><use href="#icon-recycle"/></svg></div>
          <span class="impact-num" data-count="185000">0</span>
          <span class="impact-label">Kg Scrap Recycled</span>
        </div>
        <div class="impact-card">
          <div class="impact-icon"><svg class="icon icon-lg"><use href="#icon-cloud"/></svg></div>
          <span class="impact-num" data-count="240">0</span>
          <span class="impact-label">Tonnes CO₂ Avoided</span>
        </div>
        <div class="impact-card">
          <div class="impact-icon"><svg class="icon icon-lg"><use href="#icon-tree"/></svg></div>
          <span class="impact-num" data-count="3100">0</span>
          <span class="impact-label">Trees Saved (Equivalent)</span>
        </div>
        <div class="impact-card">
          <div class="impact-icon"><svg class="icon icon-lg"><use href="#icon-building"/></svg></div>
          <span class="impact-num" data-count="10000">0</span>
          <span class="impact-label">Clients Served</span>
        </div>
      </div>
      <p class="impact-note">Impact figures are estimates based on standard industry recycling benchmarks, updated periodically.</p>
    </div>
  </section>


  <!-- Live Rates teaser -->
  <section class="section" id="rates">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Indicative Rates</span>
        <h2>Scrap Rates at a Glance</h2>
        <p>Reference prices per kg for common categories. Business lots are priced on volume, grade and location — request a bulk quote for your exact rate.</p>
      </div>
      <div class="rates-grid" id="ratesGrid" data-limit="6">
        <!-- populated by JS -->
        <div class="rates-loading">Loading current rates…</div>
      </div>
      <p class="section-more">
        <a href="/rates" class="btn btn-outline">View All Indicative Rates</a>
        <a href="/book-pickup" class="btn btn-accent">Request a Bulk Quote</a>
      </p>
    </div>
  </section>
  <!-- How it works -->
  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Simple Process</span>
        <h2>How It Works</h2>
        <p>From enquiry to payment in your company account — in four steps.</p>
      </div>
      <div class="steps-grid steps-journey" id="stepsJourney">
        <div class="journey-track" aria-hidden="true">
          <span class="journey-fill"></span>
          <svg class="icon journey-truck"><use href="#icon-truck"/></svg>
        </div>
        <div class="step-card">
          <span class="step-num">1</span>
          <h3>Share Your Requirement</h3>
          <p>Tell us the scrap type, approximate volume, site location and whether it's a one-time or regular pickup.</p>
        </div>
        <div class="step-card">
          <span class="step-num">2</span>
          <h3>Get a Bulk Quote</h3>
          <p>We assess the lot and quote a rate based on volume, grade and location — by phone, or in your online account where you can accept it.</p>
        </div>
        <div class="step-card">
          <span class="step-num">3</span>
          <h3>Pickup &amp; Weighbridge</h3>
          <p>Our team collects from your site and weighs the load, with a weight slip for your records.</p>
        </div>
        <div class="step-card">
          <span class="step-num">4</span>
          <h3>GST Invoice &amp; Payment</h3>
          <p>You receive a GST invoice and payment by bank transfer to your company account.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="section" id="why">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why Scrap Express</span>
        <h2>A Scrap Partner Built for Business</h2>
        <p>35+ years in Delhi's scrap trade, with the paperwork your accounts team needs.</p>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-paper"/></svg>
          <h3>GST Invoice on Every Deal</h3>
          <p>Proper GST billing for every transaction, ready for your company's books.</p>
        </div>
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-scale"/></svg>
          <h3>Weighbridge Weight Slips</h3>
          <p>Every load is weighed and you get a weight slip — no disputes over quantity.</p>
        </div>
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-shield"/></svg>
          <h3>Bank Transfer Payments</h3>
          <p>Payment straight to your company account, with a clear record for audits.</p>
        </div>
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-clock"/></svg>
          <h3>One-Time or Scheduled</h3>
          <p>Clear a large lot in one go, or set up regular weekly or monthly collection.</p>
        </div>
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-truck"/></svg>
          <h3>On-Site Bulk Pickup</h3>
          <p>We collect from your factory, office or site — your team doesn't move a thing.</p>
        </div>
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-leaf"/></svg>
          <h3>Responsible Recycling</h3>
          <p>Scrap is sorted by material and sent on for recycling rather than landfill.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section-alt" id="reviews">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Client Feedback</span>
        <h2>What Our Clients Say</h2>
      </div>
      <div class="reviews-grid" id="reviewsGrid">
        <div class="rates-loading">Loading reviews…</div>
      </div>
    </div>
  </section>

<%- include('partials/cta') %>

</main>

<%- include('partials/footer') %>
