<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top" tabindex="-1">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-blob blob-1"></div>
    <div class="hero-blob blob-2"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow eyebrow-live"><span class="live-dot" aria-hidden="true"></span> B2B Scrap Buyers • Delhi NCR</span>
        <h1>Scrap Ka Dher? <span class="text-accent">Hum Hai Na!</span><span class="sr-only"> Bulk scrap buyers for businesses across Delhi NCR.</span></h1>
        <p class="hero-rotator">
          <span aria-hidden="true">Bulk scrap pickup from your</span>
          <% const rotatorWords = locals.lang === 'hi'
            ? ['फैक्ट्री', 'ऑफिस', 'अस्पताल', 'रेस्टोरेंट', 'गोदाम', 'स्कूल', 'मॉल', 'होटल']
            : ['factory', 'office', 'hospital', 'restaurant', 'warehouse', 'school', 'mall', 'hotel']; %>
          <span class="rotator-word" id="heroRotator" aria-hidden="true" data-no-translate
                data-words='<%= JSON.stringify(rotatorWords) %>'><%= rotatorWords[0] %></span><span class="rotator-caret" aria-hidden="true"></span>
          <span class="sr-only">Bulk scrap pickup from factories, offices, hospitals, restaurants, warehouses, schools, malls and hotels.</span>
        </p>
        <p class="hero-sub">One-time clearances or scheduled pickups of <%= minPickupKg %> kg and above, within <%= serviceKm %> km of Delhi — weighed on a weighbridge, billed with a GST invoice and paid by cash or bank transfer, whichever you prefer.</p>
        <div class="hero-cta">
          <a href="/book-pickup" class="btn btn-accent btn-lg btn-glow">Request a Bulk Quote <span class="btn-arrow" aria-hidden="true">→</span></a>
          <a href="/rates" class="btn btn-outline-light btn-lg">View Indicative Rates</a>
        </div>
        <ul class="hero-badges">
          <li><svg class="icon"><use href="#icon-paper"/></svg> GST Invoice</li>
          <li><svg class="icon"><use href="#icon-scale"/></svg> Weighbridge Slip</li>
          <li><svg class="icon"><use href="#icon-shield"/></svg> Cash or Bank Transfer</li>
        </ul>
        <%# The real numbers are in the page itself (so they show without JavaScript
            and to search engines); main.js only animates ones scrolled into view. %>
        <% const stats = locals.stats || {}; const num = (n) => Number(n || 0).toLocaleString('en-IN'); %>
        <div class="hero-stats" id="heroStats" data-live-section>
          <div class="stat"><span class="stat-num-row"><span class="stat-num" data-count="<%= stats.yearsInDelhi %>"><%= num(stats.yearsInDelhi) %></span><span class="stat-num-suffix">+</span></span><span class="stat-label">Years in Delhi</span></div>
          <div class="stat"><span class="stat-num-row"><span class="stat-num" data-count="<%= stats.locationsServed %>"><%= num(stats.locationsServed) %></span><span class="stat-num-suffix">+</span></span><span class="stat-label">Locations Served</span></div>
          <div class="stat"><span class="stat-num-row"><span class="stat-num" data-count="<%= stats.tonsPerMonth %>"><%= num(stats.tonsPerMonth) %></span><span class="stat-num-suffix">+</span></span><span class="stat-label">Tonnes Recycled / Month</span></div>
          <div class="stat"><span class="stat-num-row"><span class="stat-num" data-count="<%= stats.clientsServed %>"><%= num(stats.clientsServed) %></span><span class="stat-num-suffix">+</span></span><span class="stat-label">Clients Served</span></div>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <svg class="hero-illustration" viewBox="0 0 400 400">
          <circle class="hero-orbit" cx="200" cy="200" r="150" stroke="rgba(255,255,255,0.12)" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" fill="none"/>
          <circle class="hero-orbit hero-orbit-inner" cx="200" cy="200" r="95" stroke="rgba(245,158,11,0.18)" stroke-width="2" stroke-dasharray="1 14" stroke-linecap="round" fill="none"/>
          <use href="#icon-building" x="176" y="22" width="48" height="48" style="color:rgba(255,255,255,0.6)"/>
          <use href="#icon-truck" x="34" y="296" width="48" height="48" style="color:rgba(255,255,255,0.55)"/>
          <use href="#icon-recycle" x="308" y="296" width="48" height="48" style="color:var(--color-accent)"/>
          <circle cx="200" cy="50" r="4" fill="rgba(255,255,255,0.5)"/>
          <circle cx="70" cy="320" r="4" fill="rgba(255,255,255,0.5)"/>
          <circle cx="330" cy="320" r="4" fill="var(--color-accent)"/>
        </svg>
        <div class="hero-card card-truck">
          <svg class="icon icon-xl"><use href="#icon-truck"/></svg>
          <p>On-site pickup up to <%= serviceKm %> km from Delhi</p>
        </div>
        <div class="hero-card card-scale">
          <svg class="icon icon-xl"><use href="#icon-scale"/></svg>
          <p>Weighbridge weight slip</p>
        </div>
        <div class="hero-card card-cash">
          <span class="cash-symbol">₹</span>
          <p>GST invoice &amp; cash or bank transfer</p>
        </div>
      </div>
    </div>
    <svg class="section-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z" fill="var(--color-white)"/>
    </svg>
  </section>

  <!-- Who we serve: a slow, endless strip. The list is drawn twice so the
       loop has no visible seam; the copy is hidden from screen readers. -->
  <% const serve = [
    ['icon-gear', 'Factories'], ['icon-building', 'Offices & IT Parks'], ['icon-shield', 'Hospitals'],
    ['icon-book', 'Schools & Colleges'], ['icon-box', 'Malls & Retail'], ['icon-home', 'Hotels & Banquets'],
    ['icon-droplet', 'Restaurants & Food Chains'], ['icon-truck', 'Warehouses'], ['icon-hardhat', 'Construction Sites'],
  ]; %>
  <section class="serve-strip" aria-label="Businesses we serve">
    <div class="serve-track">
      <% [false, true].forEach((copy) => { %>
        <ul class="serve-list"<%- copy ? ' aria-hidden="true"' : '' %>>
          <% serve.forEach(([icon, label]) => { %><li><svg class="icon"><use href="#<%= icon %>"/></svg><%= label %></li><% }) %>
        </ul>
      <% }) %>
    </div>
  </section>

  <!-- Environmental Impact -->
  <section class="section section-alt" id="impact">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Impact</span>
        <h2>Every Kilogram Counts</h2>
        <p>Estimated environmental impact from scrap responsibly recycled through Scrap Express.</p>
      </div>
      <div class="impact-grid" id="impactStats" data-live-section>
        <div class="impact-card">
          <div class="impact-icon"><svg class="icon icon-lg"><use href="#icon-recycle"/></svg></div>
          <span class="impact-num" data-count="<%= stats.kgRecycled %>"><%= num(stats.kgRecycled) %></span>
          <span class="impact-label">Kg Scrap Recycled</span>
        </div>
        <div class="impact-card">
          <div class="impact-icon"><svg class="icon icon-lg"><use href="#icon-cloud"/></svg></div>
          <span class="impact-num" data-count="<%= stats.co2Tonnes %>"><%= num(stats.co2Tonnes) %></span>
          <span class="impact-label">Tonnes CO₂ Avoided</span>
        </div>
        <div class="impact-card">
          <div class="impact-icon"><svg class="icon icon-lg"><use href="#icon-tree"/></svg></div>
          <span class="impact-num" data-count="<%= stats.treesSaved %>"><%= num(stats.treesSaved) %></span>
          <span class="impact-label">Trees Saved (Equivalent)</span>
        </div>
        <div class="impact-card">
          <div class="impact-icon"><svg class="icon icon-lg"><use href="#icon-building"/></svg></div>
          <span class="impact-num" data-count="<%= stats.clientsServed %>"><%= num(stats.clientsServed) %></span>
          <span class="impact-label">Clients Served</span>
        </div>
      </div>
      <p class="impact-note">CO₂ and trees are estimates worked out from the kilograms recycled, using standard industry recycling benchmarks.<% if (stats.updatedAt) { %> Figures updated <%= new Date(stats.updatedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' }) %>.<% } %></p>
    </div>
  </section>


  <!-- Live Rates teaser -->
  <section class="section" id="rates">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Indicative Rates</span>
        <h2>Scrap Rates at a Glance</h2>
        <p>Reference prices per kg for common categories. Business lots are priced on volume, grade and location — request a bulk quote for your exact rate.</p>
      </div>
      <div class="rates-grid" id="ratesGrid" data-live-section>
        <% const teaser = (locals.rates || []).slice(0, 8); %>
        <% teaser.forEach((rate) => { %><%- include('partials/rate-card', { rate }) %><% }) %>
        <% if (!teaser.length) { %><p class="rates-loading">Rates coming soon. Please call us for current pricing.</p><% } %>
      </div>
      <p class="section-more">
        <a href="/rates" class="btn btn-outline">View All Indicative Rates</a>
        <a href="/book-pickup" class="btn btn-accent">Request a Bulk Quote</a>
      </p>
    </div>
  </section>
  <!-- How it works -->
  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Simple Process</span>
        <h2>How It Works</h2>
        <p>From enquiry to payment — in four steps.</p>
      </div>
      <div class="steps-grid steps-journey" id="stepsJourney">
        <div class="journey-track" aria-hidden="true">
          <span class="journey-fill"></span>
          <svg class="icon journey-truck"><use href="#icon-truck"/></svg>
        </div>
        <div class="step-card">
          <span class="step-num">1</span>
          <h3>Share Your Requirement</h3>
          <p>Tell us the scrap type, approximate volume, site location and whether it's a one-time or regular pickup.</p>
        </div>
        <div class="step-card">
          <span class="step-num">2</span>
          <h3>Get a Bulk Quote</h3>
          <p>We assess the lot and quote a rate based on volume, grade and location — and send it to you with a private link where you can accept it, no login needed.</p>
        </div>
        <div class="step-card">
          <span class="step-num">3</span>
          <h3>Pickup &amp; Weighbridge</h3>
          <p>Our team collects from your site and weighs the load, with a weight slip for your records.</p>
        </div>
        <div class="step-card">
          <span class="step-num">4</span>
          <h3>GST Invoice &amp; Payment</h3>
          <p>You receive a GST invoice and payment by cash or bank transfer, whichever you prefer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="section" id="why">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why Scrap Express</span>
        <h2>A Scrap Partner Built for Business</h2>
        <p>35+ years in Delhi's scrap trade, with the paperwork your accounts team needs.</p>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-paper"/></svg>
          <h3>GST Invoice on Every Deal</h3>
          <p>Proper GST billing for every transaction, ready for your company's books.</p>
        </div>
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-scale"/></svg>
          <h3>Weighbridge Weight Slips</h3>
          <p>Every load is weighed and you get a weight slip — no disputes over quantity.</p>
        </div>
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-shield"/></svg>
          <h3>Cash or Bank Transfer</h3>
          <p>Get paid the way that suits you: in cash, or straight to your bank account.</p>
        </div>
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-clock"/></svg>
          <h3>One-Time or Scheduled</h3>
          <p>Clear a large lot in one go, or set up regular weekly or monthly collection.</p>
        </div>
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-truck"/></svg>
          <h3>On-Site Bulk Pickup</h3>
          <p>We collect from your factory, office or site — your team doesn't move a thing.</p>
        </div>
        <div class="why-card">
          <svg class="icon icon-lg"><use href="#icon-leaf"/></svg>
          <h3>Responsible Recycling</h3>
          <p>Scrap is sorted by material and sent on for recycling rather than landfill.</p>
        </div>
      </div>
    </div>
  </section>

  <%# Real photos of the yard, weighbridge, trucks and team, added in the admin
      (Admin → Photos). Shown only once there are some. %>
  <% const gallery = locals.gallery || []; const logos = locals.logos || []; %>
  <section class="section" id="gallery"<%= gallery.length ? '' : ' hidden' %> data-live-section>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">See Us at Work</span>
        <h2>Our Yard, Weighbridge &amp; Team</h2>
        <p>Real photos from our yard and pickups across Delhi NCR.</p>
      </div>
      <div class="gallery-grid">
        <% gallery.forEach((photo, i) => { %>
          <figure class="gallery-item">
            <img src="<%= photo.url %>" alt="<%= photo.alt_text %>" width="<%= photo.width %>" height="<%= photo.height %>" loading="lazy" decoding="async">
            <figcaption><span class="gallery-tag"><%= (galleryCategories.find((c) => c.key === photo.category) || {}).label || '' %></span><% if (photo.caption) { %> <%= photo.caption %><% } %></figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section logos-band" id="clientLogos"<%= logos.length ? '' : ' hidden' %> data-live-section>
    <div class="container">
      <p class="logos-title">Businesses that sell their scrap to us</p>
      <ul class="logos-list">
        <% logos.forEach((logo) => { %>
          <li><img src="<%= logo.url %>" alt="<%= logo.alt_text %>" width="<%= logo.width %>" height="<%= logo.height %>" loading="lazy" decoding="async"></li>
        <% }) %>
      </ul>
    </div>
  </section>

  <%# Reviews from business clients, added in the admin. No reviews yet: no section. %>
  <% const reviews = locals.reviews || []; %>
  <section class="section section-alt" id="reviews"<%= reviews.length ? '' : ' hidden' %> data-live-section>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Business Clients</span>
        <h2>What Our Business Clients Say</h2>
      </div>
      <div class="reviews-grid" id="reviewsGrid">
        <% reviews.forEach((review) => { %>
          <figure class="review-card">
            <svg class="icon quote-mark" aria-hidden="true"><use href="#icon-quote"/></svg>
            <div class="review-stars" role="img" aria-label="Rated <%= review.rating %> out of 5">
              <% for (let i = 0; i < 5; i++) { %><svg class="icon<%= i < review.rating ? '' : ' star-off' %>" aria-hidden="true"><use href="#icon-star"/></svg><% } %>
            </div>
            <blockquote class="review-msg"><%= review.message %></blockquote>
            <figcaption class="review-footer">
              <span class="review-avatar" aria-hidden="true" style="background:<%= reviewHelpers.colorForName(review.customer_name) %>"><%= reviewHelpers.initialsFor(review.customer_name) %></span>
              <span>
                <span class="review-author"><%= review.customer_name %></span>
                <span class="review-area"><%= reviewHelpers.reviewWhere(review) %></span>
              </span>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>

  <%# Answers to what people search for. The same answers go to search engines below. %>
  <% const faqs = [
    ['Who buys scrap in bulk in Delhi NCR?', `Scrap Express buys scrap in bulk from businesses: factories, offices, IT parks, hospitals, schools, malls, hotels, banquet halls, restaurants and warehouses across Delhi NCR. Book a pickup online or call +91 98188 26333.`],
    ['Are you a kabadiwala?', `Think of us as a kabadiwala for businesses. We buy bulk scrap of ${minPickupKg} kg or more, weigh it on a weighbridge, and give you a GST invoice, so it's ready for your company's accounts.`],
    ['What scrap do you buy?', 'Paper and cardboard (raddi), plastic, iron and steel, copper, brass and aluminium, e-waste and IT equipment, old ACs and fridges, generators and motors, furniture and fixtures, glass, and mixed industrial or office scrap.'],
    ['What is the minimum quantity for a pickup?', `${minPickupKg} kg per pickup. You can add up several kinds of scrap to reach it. For smaller amounts, we may not be the right fit.`],
    ['Which areas do you cover?', `Delhi and anywhere within ${serviceKm} km of Delhi's boundary, including Gurugram, Manesar, Noida, Greater Noida, Faridabad, Ghaziabad, Sonipat, Bahadurgarh and Meerut.`],
    ['What are the scrap rates today?', 'Our Scrap Rates page shows indicative rates per kg, updated regularly. Your final rate depends on volume, grade and location, and we send it as a quote after seeing your details and photos.'],
    ['How and when will I be paid?', 'By cash or bank transfer, whichever you prefer. The amount is worked out from the weighbridge weight at pickup, with a GST invoice.'],
    ['Do I need to create an account?', 'No. We send your quote on WhatsApp or email with a private link where you can accept it. An account is optional, and lets you track all your requests in one place.'],
    ['Do you also do demolition?', `Yes. We demolish commercial and institutional buildings such as schools, hospitals, factories, warehouses and malls within ${serviceKm} km of Delhi, after a site survey and a detailed quote.`],
  ]; %>
  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Selling Scrap in Delhi NCR: Common Questions</h2>
      </div>
      <div class="faq-list">
        <% faqs.forEach(([question, answer]) => { %>
          <details class="faq-item">
            <summary><%= question %></summary>
            <p><%= answer %></p>
          </details>
        <% }) %>
      </div>
    </div>
  </section>

<%- include('partials/cta') %>

<%# Business details for search engines (Google, Bing), in their standard format. %>
<% const jsonLd = (data) => JSON.stringify(data).replace(/</g, '\\u003c'); %>
<script type="application/ld+json"><%- jsonLd({
  '@context': 'https://schema.org',
  '@type': 'RecyclingCenter',
  name: 'Scrap Express',
  description: 'Bulk scrap buyers for businesses in Delhi NCR: pickup from factories, offices, hospitals, hotels and restaurants, weighbridge weight, GST invoice, and building demolition.',
  url: `${siteUrl}/`,
  logo: `${siteUrl}/icons/icon-512.png`,
  image: `${siteUrl}/images/og-image.png`,
  telephone: '+91-98188-26333',
  email: 'scrapexpress@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Delhi', addressRegion: 'Delhi', addressCountry: 'IN' },
  areaServed: ['Delhi', 'Gurugram', 'Noida', 'Greater Noida', 'Faridabad', 'Ghaziabad', 'Sonipat', 'Bahadurgarh', 'Manesar', 'Meerut']
    .map((city) => ({ '@type': 'City', name: city })),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '09:00', closes: '14:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '09:00', closes: '20:00' },
  ],
  paymentAccepted: 'Cash, Bank Transfer',
  knowsAbout: ['Scrap buying', 'Bulk scrap pickup', 'E-waste recycling', 'Industrial scrap', 'Building demolition'],
}) %></script>
<script type="application/ld+json"><%- jsonLd({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
}) %></script>

</main>

<%- include('partials/footer') %>
