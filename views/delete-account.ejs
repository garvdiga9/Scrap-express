<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top">

  <section class="section page-top">
    <div class="container legal-page">
      <span class="eyebrow">Your Account</span>
      <h1>Delete Your Scrap Express Account</h1>
      <div class="form-alert success" id="deletedNotice" hidden>Your account has been deleted. Thank you for using Scrap Express.</div>

      <h2>Delete it yourself (quickest)</h2>
      <ol>
        <li>Open the Scrap Express app or website and <a href="/login?next=/account">log in</a>.</li>
        <li>Go to <strong>My Account</strong>.</li>
        <li>Scroll to the bottom and tap <strong>Delete My Account</strong>.</li>
        <li>Confirm by signing in with Google once more. Your account is deleted straight away.</li>
      </ol>

      <h2>Or ask us to delete it</h2>
      <p>Can't log in? Contact us from the phone number or email address on your account and ask us to delete it. We will do so within 7 days and confirm.</p>
      <p>Phone / WhatsApp: <a href="tel:+919818826333">+91 98188 26333</a><br>
        Email: <a href="mailto:scrapexpress@gmail.com?subject=Delete%20my%20Scrap%20Express%20account">scrapexpress@gmail.com</a></p>

      <h2>What gets deleted</h2>
      <ul>
        <li>Your account, sign-in and saved business details.</li>
        <li>All photos and videos you attached to your requests.</li>
        <li>The devices you turned notifications on for.</li>
      </ul>

      <h2>What we keep</h2>
      <p>Records of your past requests, quotes and transactions (company name, contact details, scrap details, quantities and amounts) are kept for as long as Indian tax law requires — GST records are generally kept for at least 6 years. These records are no longer linked to any account.</p>

      <p>See our <a href="/privacy">Privacy Policy</a> for more.</p>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
