<%# Dark banner at the top of an inner page.
    Locals: eyebrow, heading, text, and optionally links = [{ href, label }]. %>
  <section class="hero page-hero">
    <div class="hero-blob blob-1"></div>
    <div class="hero-blob blob-2"></div>
    <div class="container">
      <span class="eyebrow"><%= eyebrow %></span>
      <h1><%= heading %></h1>
      <p class="hero-sub"><%= text %></p>
      <% if (locals.links) { %>
      <nav class="page-hero-links" aria-label="On this page">
        <% links.forEach((link) => { %><a href="<%= link.href %>"><%= link.label %></a>
        <% }) %>
      </nav>
      <% } %>
    </div>
    <svg class="section-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z" fill="var(--color-bg)"/>
    </svg>
  </section>
