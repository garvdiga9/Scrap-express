<!-- Header -->
<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a href="/" class="brand">
      <svg class="icon brand-icon"><use href="#icon-recycle"/></svg>
      <span>Scrap <strong>Express</strong></span>
    </a>
    <nav class="main-nav" id="mainNav">
      <a href="/rates" class="nav-link<%= page === 'rates' ? ' active' : '' %>">Scrap Rates</a>
      <a href="/what-we-buy" class="nav-link<%= page === 'what-we-buy' ? ' active' : '' %>">We Buy</a>
      <a href="/book-pickup" class="nav-link<%= page === 'book-pickup' ? ' active' : '' %>">Bulk Pickup</a>
      <a href="/demolition" class="nav-link<%= page === 'demolition' ? ' active' : '' %>">Demolition</a>
      <a href="/areas" class="nav-link<%= page === 'areas' ? ' active' : '' %>">Areas</a>
      <% if (locals.loginEnabled || locals.customer) { %>
      <a href="<%= locals.customer ? '/account' : '/login' %>" class="nav-link nav-account<%= ['login', 'account'].includes(page) ? ' active' : '' %>"><%= locals.customer ? 'My Account' : 'Customer Login' %></a>
      <% } %>
    </nav>
    <div class="header-actions">
      <a href="tel:+919818826333" class="btn btn-ghost header-call" aria-label="Call +91 98188 26333">
        <svg class="icon"><use href="#icon-phone"/></svg>
        <span>+91 98188 26333</span>
      </a>
      <% if (locals.loginEnabled || locals.customer) { %>
      <a href="<%= locals.customer ? '/account' : '/login' %>" class="btn btn-ghost header-account<%= ['login', 'account'].includes(page) ? ' active' : '' %>">
        <svg class="icon"><use href="#icon-user"/></svg>
        <span><%= locals.customer ? 'My Account' : 'Login' %></span>
      </a>
      <% } %>
      <a href="/book-pickup" class="btn btn-accent">Get a Quote</a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <svg class="icon"><use href="#icon-menu"/></svg>
      </button>
    </div>
  </div>
</header>
