<a href="#top" class="skip-link">Skip to main content</a>
<!-- Header -->
<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a href="/" class="brand">
      <svg class="icon brand-icon"><use href="#icon-recycle"/></svg>
      <span>Scrap <strong>Express</strong></span>
    </a>
    <nav class="main-nav" id="mainNav" aria-label="Main">
      <a href="/rates" class="nav-link<%= page === 'rates' ? ' active' : '' %>">Scrap Rates</a>
      <a href="/what-we-buy" class="nav-link<%= page === 'what-we-buy' ? ' active' : '' %>">What We Buy</a>
      <a href="/book-pickup" class="nav-link<%= page === 'book-pickup' ? ' active' : '' %>">Bulk Pickup</a>
      <a href="/demolition" class="nav-link<%= page === 'demolition' ? ' active' : '' %>">Demolition</a>
      <a href="/areas" class="nav-link<%= page === 'areas' ? ' active' : '' %>">Areas</a>
      <a href="tel:+919818826333" class="nav-link nav-account" data-callback>Request a Call Back</a>
      <a href="<%= locals.langUrl ? langUrl(locals.lang === 'hi' ? 'en' : 'hi') : '?lang=hi' %>" class="nav-link nav-lang" lang="<%= locals.lang === 'hi' ? 'en' : 'hi' %>"><%= locals.lang === 'hi' ? 'English' : 'हिंदी में पढ़ें' %></a>
      <button type="button" class="nav-link nav-theme" data-theme-toggle><span class="theme-label-light">Dark theme</span><span class="theme-label-dark">Light theme</span></button>
      <% if (locals.loginEnabled || locals.customer) { %>
      <a href="<%= locals.customer ? '/account' : '/login' %>" class="nav-link nav-account<%= ['login', 'account'].includes(page) ? ' active' : '' %>"><%= locals.customer ? 'My Account' : 'Customer Login' %></a>
      <% } %>
    </nav>
    <div class="header-actions">
      <a href="tel:+919818826333" class="btn btn-ghost header-callback" data-callback>Request a Call Back</a>
      <% if (locals.loginEnabled || locals.customer) { %>
      <a href="<%= locals.customer ? '/account' : '/login' %>" class="btn btn-ghost header-account<%= ['login', 'account'].includes(page) ? ' active' : '' %>">
        <svg class="icon"><use href="#icon-user"/></svg>
        <span><%= locals.customer ? 'My Account' : 'Login' %></span>
      </a>
      <% } %>
      <% const toHindi = locals.lang !== 'hi'; %>
      <a href="<%= locals.langUrl ? langUrl(toHindi ? 'hi' : 'en') : (toHindi ? '?lang=hi' : '?lang=en') %>" class="lang-toggle" lang="<%= toHindi ? 'hi' : 'en' %>" hreflang="<%= toHindi ? 'hi' : 'en' %>" title="<%= toHindi ? 'Read this page in Hindi' : 'Read this page in English' %>"><%= toHindi ? 'हिंदी' : 'English' %></a>
      <button type="button" class="theme-toggle" id="themeToggle" data-theme-toggle aria-label="Switch to dark theme" title="Light / dark theme">
        <svg class="icon icon-when-light" aria-hidden="true"><use href="#icon-moon"/></svg>
        <svg class="icon icon-when-dark" aria-hidden="true"><use href="#icon-sun"/></svg>
      </button>
      <a href="/book-pickup" class="btn btn-accent">Get a Quote</a>
      <button type="button" class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mainNav">
        <svg class="icon"><use href="#icon-menu"/></svg>
      </button>
    </div>
  </div>
</header>
