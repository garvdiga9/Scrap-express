<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top">

  <!-- Live Rates -->
  <section class="section page-top" id="rates">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Indicative Rates</span>
        <h2>Scrap Rates</h2>
        <p>Reference prices per kg (unless noted) for common scrap categories. Business lots are priced on volume, grade and location, so your final rate comes in a bulk quote.</p>
        <a href="#subscribe" class="btn btn-outline rates-subscribe-link">🔔 Get these rates every morning</a>
      </div>
      <div class="rates-grid" id="ratesGrid">
        <!-- populated by JS -->
        <div class="rates-loading">Loading current rates…</div>
      </div>
      <div class="rates-quote-note">
        <div>
          <h3>Selling in bulk?</h3>
          <p>Final rates depend on volume, grade and pickup frequency. Tell us what you have and we'll send a quote for your lot.</p>
        </div>
        <a href="/book-pickup" class="btn btn-accent btn-lg">Request a Bulk Quote</a>
      </div>
    </div>
  </section>

<%- include('partials/cta') %>

</main>

<%- include('partials/footer') %>
