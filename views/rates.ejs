<%- include('partials/head') %>
<%- include('partials/sprite') %>
<%- include('partials/header') %>

<main id="top">

  <!-- Live Rates -->
  <section class="section page-top" id="rates">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Updated Daily</span>
        <h2>Live Scrap Rates</h2>
        <p>Transparent, market-linked prices for every category. Rates below are per kg unless noted.</p>
      </div>
      <div class="rates-grid" id="ratesGrid">
        <!-- populated by JS -->
        <div class="rates-loading">Loading current rates…</div>
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="cta-banner">
    <div class="container cta-inner">
      <h2>Got Scrap Lying Around at Home or Office?</h2>
      <p>Book a free pickup today and turn clutter into cash.</p>
      <div class="cta-actions">
        <a href="#book" class="btn btn-accent btn-lg">Book Pickup Now</a>
        <a href="tel:+919818826333" class="btn btn-outline-light btn-lg">
          <svg class="icon"><use href="#icon-phone"/></svg> Call Us
        </a>
      </div>
    </div>
    <svg class="section-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,40 C240,0 480,80 720,40 C960,0 1200,80 1440,40 L1440,80 L0,80 Z" fill="var(--color-dark)"/>
    </svg>
  </section>

</main>

</main>

<%- include('partials/footer') %>
