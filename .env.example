PORT=3000

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/scrap_express

# Used to sign the admin login session cookie - change this to a long random string
SESSION_SECRET=change_this_to_a_long_random_string

# Seeded admin dashboard login (change the password before going live)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Customer login (Firebase Authentication — Google + phone OTP).
# Leave blank to keep customer login switched off; the rest of the site works.
# Firebase console > Project settings > General > Your apps > Web app config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Phone OTP login needs Firebase's paid Blaze plan. Set to true only after
# adding billing in the Firebase console; until then only Google login shows.
FIREBASE_PHONE_LOGIN=false

# Where customer photos/videos are saved. Defaults to ./uploads; on Render it
# points at the persistent disk (see render.yaml).
# UPLOAD_DIR=

# Public address of the site, used in links inside emails.
SITE_URL=https://scrap-express.onrender.com
# When you move to your own domain, change SITE_URL to it (e.g.
# https://www.scrapexpress.in). Canonical tags, sitemap, robots.txt, emails
# and quote links all follow, and visits to the old *.onrender.com address
# are forwarded to the same page on the new domain. Set this to false to
# stop that forwarding:
# REDIRECT_TO_SITE_URL=true

# Google Analytics 4 (optional), e.g. G-ABC123XYZ. Leave blank to use only
# the site's own visit counts (Admin → Analytics).
GA_MEASUREMENT_ID=

# Email for daily rates & announcements (Gmail). SMTP_PASS is a Gmail
# "App Password" (Google Account > Security > 2-Step Verification > App
# passwords), not the normal password. Leave blank to keep email off.
SMTP_USER=
SMTP_PASS=

# Automatic WhatsApp (Meta WhatsApp Cloud API). Leave blank to keep it off;
# numbers are still collected. Templates must be approved in Meta and have
# one {{1}} variable each.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RATES_TEMPLATE=
WHATSAPP_NEWS_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Play Store app: package name and the SHA-256 fingerprint(s) of its signing
# key, comma-separated (Play Console > App integrity). Served at
# /.well-known/assetlinks.json; leave blank until the app exists.
ANDROID_PACKAGE_NAME=com.scrapexpress.app
ANDROID_SHA256_CERT_FINGERPRINTS=

# Search engines: the ownership codes Google Search Console and Bing Webmaster
# Tools give you when you add the site with the "HTML tag" method (just the
# content="..." value). Leave blank until then.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Automatic WhatsApp for a customer's pickup updates (slot booked, on the way,
# weighed, paid). Needs a Meta-approved utility template with one {{1}}.
WHATSAPP_PICKUP_TEMPLATE=

# ---- Business name and contacts (lib/brand.js) ----
# Leave empty to keep "Scrap Express", +91 98188 26333 and scrapexpress@gmail.com.
# Set these (on Render → Environment) to rename the business everywhere: pages,
# Hindi pages, the admin and staff apps, emails, WhatsApp texts and app alerts.
BRAND_NAME=
BRAND_SHORT=
BRAND_PHONE=
BRAND_EMAIL=
