PORT=3000

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/kabadi_express

# Used to sign the admin login session cookie - change this to a long random string
SESSION_SECRET=change_this_to_a_long_random_string

# Seeded admin dashboard login (change the password before going live)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
